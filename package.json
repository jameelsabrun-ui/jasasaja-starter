{
  "name": "jasasaja-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "setup:hooks": "sh scripts/install-hooks.sh"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.41.0",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "packageManager": "pnpm@12.18.0"
}
