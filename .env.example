# Salin ke .env.local lalu isi. JANGAN commit file berisi nilai asli.
# Semua variabel di bawah WAJIB; aplikasi gagal start jika ada yang kosong (src/lib/env.ts).

# Neon: connection string POOLED untuk aplikasi (region Singapura disarankan)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Neon: connection string LANGSUNG untuk migrasi drizzle-kit (opsional di lokal)
DATABASE_URL_UNPOOLED=

# Upstash Redis (rate limit)
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=ganti-dengan-token-upstash

# Xendit: callback verification token dari dashboard Xendit (berbeda untuk test dan live)
XENDIT_CALLBACK_TOKEN=ganti-dengan-callback-token-xendit

# Secret acak minimal 32 karakter: openssl rand -base64 32
AUTH_SECRET=ganti-dengan-hasil-openssl-rand-base64-32-karakter-atau-lebih
