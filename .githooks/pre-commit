#!/bin/sh
# Blokir commit yang berisi rahasia. Jika gitleaks belum terpasang, commit DITOLAK (fail-closed).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks belum terpasang. Pasang dulu, atau commit dengan --no-verify (tidak disarankan)." >&2
  exit 1
fi
exec gitleaks protect --staged --redact --no-banner --config .gitleaks.toml
